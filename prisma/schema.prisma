datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Deck {
  id          String         @id @default(uuid())
  title       String
  description String?
  isPublic    Boolean        @default(false)
  userId      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  words       Word[]
  articles    ClozeArticle[]
  quizzes     QuizQuestion[]
  results     QuizResult[]
}

model Word {
  id          String   @id @default(uuid())
  deckId      String
  word        String
  phonetic    String?
  pos         String?
  translation String
  definition  String?
  example     String?
  exampleZh   String?
  isMastered  Boolean  @default(false)
  createdAt   DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model ClozeArticle {
  id          String   @id @default(uuid())
  deckId      String
  title       String
  content     String
  contentZh   String?
  blanksJson  String
  createdAt   DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id          String   @id @default(uuid())
  deckId      String
  question    String
  questionZh  String?
  targetWord  String
  optionsJson String
  correctIdx  Int
  explanation String?
  createdAt   DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id          String   @id @default(uuid())
  deckId      String
  score       Int
  total       Int
  answersJson String
  createdAt   DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}