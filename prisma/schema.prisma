datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Deck {
  id          String         @id @default(uuid())
  title       String
  description String?
  isPublic    Boolean        @default(false)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  words       Word[]
  articles    ClozeArticle[]
  quizzes     QuizQuestion[]
  results     QuizResult[]
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  decks     Deck[]
}

model Word {
  id          String   @id @default(uuid())
  deckId      String
  word        String
  phonetic    String?
  pos         String?
  translation String
  definition  String?
  example     String?
  exampleZh   String?
  isMastered  Boolean  @default(false)
  createdAt   DateTime @default(now())

  deck         Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  senses       Sense[]
  sentenceUses SentenceWord[]

  @@index([word])
  @@index([deckId])
}

model ClozeArticle {
  id           String   @id @default(uuid())
  deckId       String
  title        String
  content      String
  contentZh    String?
  blanksJson   String
  glossaryJson String?
  createdAt    DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id          String   @id @default(uuid())
  deckId      String
  question    String
  questionZh  String?
  targetWord  String
  optionsJson String
  correctIdx  Int
  explanation String?
  createdAt   DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id          String   @id @default(uuid())
  deckId      String
  score       Int
  total       Int
  answersJson String
  createdAt   DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

// =========================
// Context Engine V2
// =========================

model Sense {
  id          String   @id @default(uuid())
  wordId      String
  translation String
  definition  String?
  cefr        String?
  domain      String?
  register    String?
  createdAt   DateTime @default(now())

  word        Word             @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examples    SenseExample[]
  candidates  SlotCandidate[]
  collocations Collocation[]
  contexts    SenseContext[]

  @@index([wordId])
  @@index([domain])
  @@index([cefr])
  @@index([cefr, domain, register])
}

model SenseExample {
  id          String @id @default(uuid())
  senseId     String
  content     String
  translation String?

  sense Sense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([senseId])
}

model Collocation {
  id          String   @id @default(uuid())
  senseId     String
  pattern     String
  type        String?
  register    String?
  domain      String?
  frequency   Int      @default(0)
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())

  sense Sense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([senseId, pattern])
  @@index([pattern])
  @@index([senseId, frequency])
  @@index([domain, register])
}

model SemanticSlot {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  pos         String
  description String?

  candidates SlotCandidate[]
  templates  TemplateSlot[]

  createdAt DateTime @default(now())
}

model SlotCandidate {
  id                String @id @default(uuid())
  slotId            String
  senseId           String
  priority          Int    @default(0)
  weight            Float  @default(1)
  minCEFR           String?
  maxCEFR           String?
  grammarPatternId  String?

  slot           SemanticSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  sense          Sense           @relation(fields: [senseId], references: [id], onDelete: Cascade)
  grammarPattern GrammarPattern? @relation(fields: [grammarPatternId], references: [id], onDelete: SetNull)

  @@unique([slotId, senseId])
  @@index([slotId, priority, weight])
  @@index([senseId])
  @@index([grammarPatternId])
}

model GrammarPattern {
  id          String @id @default(uuid())
  name        String
  pattern     String
  description String?

  candidates SlotCandidate[]
  templateSlots TemplateSlot[]

  createdAt DateTime @default(now())

  @@index([name])
}

model ContextProfile {
  id          String   @id @default(uuid())
  code        String   @unique
  theme       String
  domain      String?
  situation   String?
  setting     String?
  intent      String?
  audience    String?
  register    String?
  cefr        String?
  description String?
  createdAt   DateTime @default(now())

  senses      SenseContext[]
  templates   TemplateContext[]
  sentences   SentenceContext[]

  @@index([theme, cefr])
  @@index([domain, register])
  @@index([setting, intent])
}

model SenseContext {
  senseId         String
  contextProfileId String
  relevance       Float @default(1)

  sense          Sense         @relation(fields: [senseId], references: [id], onDelete: Cascade)
  contextProfile ContextProfile @relation(fields: [contextProfileId], references: [id], onDelete: Cascade)

  @@id([senseId, contextProfileId])
  @@index([contextProfileId, relevance])
}

model Template {
  id             String @id @default(uuid())
  title          String
  theme          String
  difficulty     String
  content        String
  wordCount      Int?
  sentenceCount  Int?
  situation      String?
  register       String?
  qualityScore   Float?
  createdAt      DateTime @default(now())

  slots      TemplateSlot[]
  tags       TemplateTag[]
  contexts   TemplateContext[]
  instances  ContextInstance[]
  sentences  Sentence[]
  articles   Article[]

  @@index([theme, difficulty, qualityScore])
  @@index([register, qualityScore])
}

model TemplateContext {
  templateId      String
  contextProfileId String
  relevance       Float @default(1)

  template       Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  contextProfile ContextProfile @relation(fields: [contextProfileId], references: [id], onDelete: Cascade)

  @@id([templateId, contextProfileId])
  @@index([contextProfileId, relevance])
}

model TemplateSlot {
  id                String @id @default(uuid())
  templateId        String
  slotId            String
  placeholder       String
  position          Int
  required          Boolean @default(true)
  grammarPatternId  String?

  template       Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  slot           SemanticSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  grammarPattern GrammarPattern? @relation(fields: [grammarPatternId], references: [id], onDelete: SetNull)

  @@unique([templateId, placeholder])
  @@index([templateId, position])
  @@index([slotId])
}

model ContextTag {
  id   String @id @default(uuid())
  name String @unique

  templates TemplateTag[]
}

model TemplateTag {
  templateId String
  tagId      String

  template Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      ContextTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@index([tagId])
}

model ContextInstance {
  id            String @id @default(uuid())
  templateId    String
  content       String
  translation   String?
  difficulty    String
  theme         String
  qualityScore  Float?
  createdAt     DateTime @default(now())

  template  Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sentences Sentence[]
  articles  Article[]

  @@index([templateId])
  @@index([theme, difficulty, qualityScore])
}

model Sentence {
  id                String @id @default(uuid())
  content           String
  translation       String?
  difficulty        String?
  theme             String?
  sourceType        String?
  templateId        String?
  contextInstanceId String?
  normalizedKey     String? @unique
  qualityScore      Float?
  grammarScore      Float?
  naturalnessScore  Float?
  meaningScore      Float?
  contextScore      Float?
  cefrScore         Float?
  diversityScore    Float?
  createdAt         DateTime @default(now())

  template        Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contextInstance ContextInstance? @relation(fields: [contextInstanceId], references: [id], onDelete: SetNull)
  contexts        SentenceContext[]
  quality         SentenceQuality?
  words           SentenceWord[]

  @@index([templateId])
  @@index([contextInstanceId])
  @@index([theme, difficulty, qualityScore])
  @@index([qualityScore, contextScore, naturalnessScore])
  @@index([sourceType])
}

model SentenceContext {
  sentenceId       String
  contextProfileId String
  relevance        Float @default(1)

  sentence       Sentence       @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  contextProfile ContextProfile @relation(fields: [contextProfileId], references: [id], onDelete: Cascade)

  @@id([sentenceId, contextProfileId])
  @@index([contextProfileId, relevance])
}

model SentenceQuality {
  sentenceId       String   @id
  grammarScore     Float
  naturalnessScore Float
  meaningScore     Float
  contextScore     Float
  cefrScore        Float
  diversityScore   Float
  overallScore     Float
  validatorVersion String?
  reviewedAt       DateTime @default(now())

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@index([overallScore])
}

model SentenceWord {
  sentenceId String
  wordId     String
  isTarget   Boolean @default(false)
  position   Int?

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([sentenceId, wordId])
  @@index([wordId, isTarget, sentenceId])
}

model Article {
  id                String @id @default(uuid())
  title             String
  content           String
  translation       String?
  theme             String
  difficulty        String
  wordCount         Int
  sentenceCount     Int
  templateId        String?
  contextInstanceId String?
  qualityScore      Float?
  createdAt         DateTime @default(now())

  template        Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contextInstance ContextInstance? @relation(fields: [contextInstanceId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([contextInstanceId])
  @@index([theme, difficulty, qualityScore])
}
